# ===========================================================================
# ModernRx configuration (PRD §21)
#
#   cp .env.example .env
#
# Everything here has a working default. ModernRx runs with NO configuration at
# all: without GEMINI_API_KEY the LLM stages fall back to their deterministic
# reasoners and label every output `generator: deterministic`.
# ===========================================================================

# ---- LLM -------------------------------------------------------------------
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# The model id is pinned and recorded with every AI output (Annex 22).
LLM_MODEL=gemini-3.1-flash-lite
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=4000
LLM_TIMEOUT_SECONDS=90

# false = send only summaries and metadata to the model, never raw source.
# Secrets found in configuration are masked at parse time either way.
LLM_SEND_RAW_CODE=false

# ---- Datastores ------------------------------------------------------------
# The knowledge graph lives in an embedded store (NetworkX persisted to SQLite),
# so no graph server is required. Set NEO4J_URI only if you also want the graph
# mirrored into a real Neo4j for live Cypher:
#     docker compose up -d neo4j
# NEO4J_URI=bolt://localhost:7687
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=modernrx-dev

# Blank uses <repo>/data/modernrx.db
DATABASE_URL=
DATA_DIR=./data

# ---- Engine 4: decomposition ----------------------------------------------
# structural, runtime, data, cochange, semantic  (PRD §11.1). Normalised on load;
# the weight of any signal a project lacks is redistributed over the rest.
DECOMP_WEIGHTS=0.30,0.20,0.25,0.10,0.15

# Objective = alpha*Coupling - beta*Cohesion + gamma*RevalScope
DECOMP_ALPHA=1.0
DECOMP_BETA=1.0
DECOMP_GAMMA=1.5
HDBSCAN_MIN_CLUSTER_SIZE=4

# ---- Engine 5: effort model (PRD §12.5) -----------------------------------
GXP_MULTIPLIER_HIGH=1.8
GXP_MULTIPLIER_MEDIUM=1.3
GXP_MULTIPLIER_LOW=1.0

# ---- Engine 6: roadmap -----------------------------------------------------
MONTECARLO_RUNS=10000
MONTECARLO_SEED=20260413
ROADMAP_SOLVER_SECONDS=10
SQUAD_COUNT=3
